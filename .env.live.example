# Copy to `.env.live` and fill in. `.env.live` is gitignored; never commit it.
#
# Generate the two SABnzbd keys with `openssl rand -hex 16`. They are only ever
# used between the containers on the compose network.
SAB_API_KEY=
SAB_NZB_KEY=

# The Usenet account SABnzbd downloads through. Port 563 is the SSL port.
USENET_HOST=
USENET_PORT=563
USENET_USERNAME=
USENET_PASSWORD=

# A Newznab indexer and its API key, and a ThePornDB key for metadata.
NEWZNAB_URL=
NEWZNAB_API_KEY=
TPDB_API_KEY=
