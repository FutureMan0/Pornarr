# Bootstrap configuration only.
# Indexers, download clients, metadata providers, quality profiles and content
# filters are configured in the UI and stored encrypted in the database.

APP_ENV=development

# Image tag to run. Pin this to a published release before upgrading production.
PORNARR_TAG=latest

# Derives the encryption key for every stored credential.
# Generate with: openssl rand -hex 32
# Back this up. A database restored without it has unreadable credentials.
APP_SECRET=

DATABASE_URL=postgresql+psycopg://pornarr:pornarr@postgres:5432/pornarr
REDIS_URL=redis://redis:6379/0

# One filesystem. Downloads and library MUST share it, or hardlinking fails and
# every import silently degrades to a full copy.
# See docs/operations/deployment.md
DATA_PATH=/data

# Backup dumps are written by `make backup`. Leave the age empty to omit backup
# freshness from /api/health.
BACKUP_PATH=/backups
BACKUP_MAX_AGE_HOURS=
# Host directory mounted at BACKUP_PATH by Docker Compose.
BACKUP_PATH_HOST=./backups

# Set when serving under a sub-path behind a reverse proxy, e.g. /pornarr
BASE_PATH=

# The session and CSRF cookies carry `Secure`, so they are never sent over a
# plain HTTP connection. Leave this alone: the documented deployment terminates
# TLS in a reverse proxy. Set it to false ONLY for local development over
# http://localhost, where a browser refuses to store a Secure cookie at all.
# It is refused outright when APP_ENV=production.
SESSION_COOKIE_SECURE=true

# Addresses this instance may believe `X-Forwarded-For` from, comma-separated,
# as addresses or CIDR blocks. Empty means believe nobody.
#
# Behind a reverse proxy every request arrives from the proxy, so the login rate
# limiter counts the whole instance in one bucket and six wrong guesses from one
# anonymous caller lock everybody out for fifteen minutes. Naming the proxy here
# makes the limiter count real clients again. Name only addresses you control:
# anyone can write that header, and an instance that believes it from an
# arbitrary caller has no rate limit at all.
# Example: TRUSTED_PROXIES=127.0.0.1,172.18.0.0/16
TRUSTED_PROXIES=

# Transcoding. Leave empty to detect at startup.
# Values: auto | nvenc | vaapi | qsv | none
TRANSCODE_HWACCEL=auto
TRANSCODE_MAX_HW_SESSIONS=
TRANSCODE_MAX_SW_SESSIONS=
TRANSCODE_MAX_PER_USER=2
# Nightly cleanup retains new segment directories for this grace period, then
# removes orphaned directories and evicts non-live entries to the cache cap.
TRANSCODE_CLEANUP_MIN_AGE_SECONDS=300
TRANSCODE_CACHE_MAX_GB=10

# Mark progress complete at this percentage of the media duration.
PLAYBACK_COMPLETION_THRESHOLD_PERCENT=90

# Leave empty to retain audit records indefinitely.
AUDIT_RETENTION_DAYS=

# Automation safety limits. Automatic downloads are off by default per user.
MIN_FREE_DISK_PERCENT=15
DEFAULT_DAILY_DOWNLOAD_LIMIT_GB=10
DEFAULT_MAX_AUTO_JOBS=2
DEFAULT_AUTO_DOWNLOADS_ENABLED=false
REQUEST_MAX_ACTIVE_PER_USER=10

# Poll each enabled indexer once per interval for monitor candidates. Values
# must divide one hour so the scheduler can maintain the requested cadence.
RSS_SYNC_INTERVAL_MINUTES=15

# OIDC discovery permits public HTTPS issuers only. Enable only for a private
# or loopback IdP that this instance is explicitly meant to trust.
OIDC_ALLOW_PRIVATE_ISSUERS=false

LOG_LEVEL=info
