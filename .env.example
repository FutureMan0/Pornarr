# Bootstrap configuration only.
# Indexers, download clients, metadata providers, quality profiles and content
# filters are configured in the UI and stored encrypted in the database.

APP_ENV=development

# Derives the encryption key for every stored credential.
# Generate with: openssl rand -hex 32
# Back this up. A database restored without it has unreadable credentials.
APP_SECRET=

DATABASE_URL=postgresql+psycopg://pornarr:pornarr@postgres:5432/pornarr
REDIS_URL=redis://redis:6379/0

# One filesystem. Downloads and library MUST share it, or hardlinking fails and
# every import silently degrades to a full copy.
# See docs/operations/deployment.md
DATA_PATH=/data

# Set when serving under a sub-path behind a reverse proxy, e.g. /pornarr
BASE_PATH=

# Transcoding. Leave empty to detect at startup.
# Values: auto | nvenc | vaapi | qsv | none
TRANSCODE_HWACCEL=auto
TRANSCODE_MAX_HW_SESSIONS=
TRANSCODE_MAX_SW_SESSIONS=
TRANSCODE_MAX_PER_USER=2
# Nightly cleanup retains new segment directories for this grace period, then
# removes orphaned directories and evicts non-live entries to the cache cap.
TRANSCODE_CLEANUP_MIN_AGE_SECONDS=300
TRANSCODE_CACHE_MAX_GB=10

# Automation safety limits. Automatic downloads are off by default per user.
MIN_FREE_DISK_PERCENT=15
DEFAULT_DAILY_DOWNLOAD_LIMIT_GB=10
DEFAULT_MAX_AUTO_JOBS=2
DEFAULT_AUTO_DOWNLOADS_ENABLED=false

LOG_LEVEL=info
