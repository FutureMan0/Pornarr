                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Video Profiles"
            }
          },
          {
            "in": "query",
            "name": "maximum_video_level",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Maximum Video Level"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
