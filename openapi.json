{
  "components": {
    "schemas": {
      "ComponentHealth": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "status": {
            "enum": [
              "healthy",
              "unhealthy"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ComponentHealth",
        "type": "object"
      },
      "CurrentUserResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ],
        "title": "CurrentUserResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The contract shape for every machine-readable API error.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "context": {
            "additionalProperties": true,
            "title": "Context",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "status",
          "context"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthReport": {
        "properties": {
          "database": {
            "$ref": "#/components/schemas/ComponentHealth"
          },
          "filesystem": {
            "$ref": "#/components/schemas/ComponentHealth"
          },
          "redis": {
            "$ref": "#/components/schemas/ComponentHealth"
          },
          "status": {
            "enum": [
              "healthy",
              "degraded",
              "unhealthy"
            ],
            "title": "Status",
            "type": "string"
          },
          "worker": {
            "$ref": "#/components/schemas/ComponentHealth"
          }
        },
        "required": [
          "status",
          "database",
          "redis",
          "worker",
          "filesystem"
        ],
        "title": "HealthReport",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "format": "password",
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ProviderResponse": {
        "properties": {
          "client_id": {
            "title": "Client Id",
            "type": "string"
          },
          "discovery_fetched_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Discovery Fetched At"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "issuer": {
            "title": "Issuer",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "issuer",
          "client_id",
          "scopes",
          "enabled",
          "discovery_fetched_at"
        ],
        "title": "ProviderResponse",
        "type": "object"
      },
      "ProviderWrite": {
        "properties": {
          "client_id": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Client Id",
            "type": "string"
          },
          "client_secret": {
            "format": "password",
            "title": "Client Secret",
            "type": "string",
            "writeOnly": true
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "issuer": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Issuer",
            "type": "string"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "scopes": {
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "name",
          "issuer",
          "client_id",
          "client_secret"
        ],
        "title": "ProviderWrite",
        "type": "object"
      },
      "UserRole": {
        "enum": [
          "admin",
          "user"
        ],
        "title": "UserRole",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Pornarr",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/oidc": {
      "get": {
        "operationId": "admin_list_providers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProviderResponse"
                  },
                  "title": "Response Admin List Providers",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Providers",
        "tags": [
          "admin"
        ]
      },
      "post": {
        "operationId": "admin_create_provider",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderWrite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Provider",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/oidc/{provider_id}": {
      "delete": {
        "operationId": "admin_delete_provider",
        "parameters": [
          {
            "in": "path",
            "name": "provider_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Provider Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Provider",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/admin/oidc/{provider_id}/test": {
      "post": {
        "operationId": "admin_test_provider",
        "parameters": [
          {
            "in": "path",
            "name": "provider_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Provider Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Test Provider",
        "tags": [
          "admin"
        ]
      }
    },
