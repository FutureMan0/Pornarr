          {
            "in": "query",
            "name": "containers",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Containers"
            }
          },
          {
            "in": "query",
            "name": "video_codecs",
